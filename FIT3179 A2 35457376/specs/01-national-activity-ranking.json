{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/national-activity.json"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "labelColor": "#52606d",
      "titleColor": "#243b53",
      "gridColor": "#e7edf1",
      "domainColor": "#c9d4dc",
      "tickColor": "#c9d4dc"
    },
    "legend": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "labelColor": "#52606d",
      "titleColor": "#243b53"
    }
  },
  "width": "container",
  "height": 270,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "description": "Lollipop chart ranking adult participation rates in selected outdoor and adventure activities, Australia, 2025.",
  "layer": [
    {
      "data": {
        "url": "data/national-activity.json"
      },
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#b7d8d4"
      },
      "encoding": {
        "y": {
          "field": "activity",
          "type": "nominal",
          "sort": "-x",
          "axis": {
            "title": null,
            "labelLimit": 270
          }
        },
        "x": {
          "field": "participation_rate_pct",
          "type": "quantitative",
          "scale": {
            "zero": true
          }
        },
        "x2": {
          "datum": 0
        }
      }
    },
    {
      "data": {
        "url": "data/national-activity.json"
      },
      "mark": {
        "type": "point",
        "filled": true,
        "size": 105,
        "color": "#167d78"
      },
      "encoding": {
        "y": {
          "field": "activity",
          "type": "nominal",
          "sort": "-x",
          "axis": {
            "title": null,
            "labelLimit": 270
          }
        },
        "x": {
          "field": "participation_rate_pct",
          "type": "quantitative",
          "axis": {
            "title": "Adults participating at least once in 2025 (%)",
            "format": ".0f"
          },
          "scale": {
            "zero": true
          }
        },
        "tooltip": [
          {
            "field": "activity",
            "title": "Activity"
          },
          {
            "field": "participation_rate_pct",
            "title": "Participation rate",
            "format": ".2f"
          }
        ]
      }
    }
  ]
}