{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "National domestic tourism trips, nights and expenditure over five quarters. General tourism context only.",
  "data": { "url": "data/domestic-tourism-quarterly.json" },
  "transform": [
    { "fold": ["trips_million", "nights_million"], "as": ["measure", "value"] }
  ],
  "width": "container",
  "height": 300,
  "mark": {
    "type": "line",
    "point": { "filled": true, "size": 65 },
    "strokeWidth": 2.5
  },
  "encoding": {
    "x": {
      "field": "quarter",
      "type": "ordinal",
      "sort": [
        "Jun Qtr 2025",
        "Sep Qtr 2025",
        "Dec Qtr 2025",
        "Mar Qtr 2026",
        "Jun Qtr 2026"
      ],
      "axis": { "title": null, "labelAngle": -18 }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "axis": { "title": "Millions (trips or nights)" }
    },
    "color": {
      "field": "measure",
      "type": "nominal",
      "scale": {
        "domain": ["trips_million", "nights_million"],
        "range": ["#167d78", "#e07a43"]
      },
      "legend": {
        "title": "Measure",
        "labelExpr": "datum.label === 'trips_million' ? 'Trips' : 'Visitor nights'"
      }
    },
    "tooltip": [
      { "field": "quarter" },
      { "field": "measure" },
      { "field": "value", "title": "Millions", "format": ".2f" }
    ]
  },
  "config": {
    "view": { "stroke": null },
    "axis": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "labelColor": "#52606d",
      "titleColor": "#243b53",
      "gridColor": "#e7edf1",
      "domainColor": "#c9d4dc",
      "tickColor": "#c9d4dc"
    },
    "legend": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "labelColor": "#52606d",
      "titleColor": "#243b53"
    }
  }
}
