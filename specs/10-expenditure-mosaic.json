{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Sunburst-style nested radial chart of latest-quarter domestic overnight-trip expenditure. Inner ring groups are analytical groupings created for this visualisation; outer segments are the original TRA expenditure categories. This is general domestic tourism, not adventure-specific expenditure.",
  "data": {
    "url": "data/expenditure-sunburst.json"
  },
  "width": "container",
  "height": 360,
  "mark": {
    "type": "arc",
    "stroke": "#ffffff",
    "strokeWidth": 1.2
  },
  "encoding": {
    "theta": {
      "field": "start_angle",
      "type": "quantitative",
      "scale": null
    },
    "theta2": {
      "field": "end_angle"
    },
    "radius": {
      "field": "outer_radius",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          165
        ],
        "range": [
          0,
          165
        ]
      }
    },
    "radius2": {
      "field": "inner_radius"
    },
    "color": {
      "field": "node",
      "type": "nominal",
      "scale": {
        "scheme": "tableau20"
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "level",
        "title": "Ring"
      },
      {
        "field": "node",
        "title": "Category / group"
      },
      {
        "field": "parent",
        "title": "Parent group"
      },
      {
        "field": "value_million",
        "title": "Expenditure (A$M)",
        "format": ",.1f"
      },
      {
        "field": "share_pct",
        "title": "Share of total (%)",
        "format": ".1f"
      }
    ]
  },
  "view": {
    "stroke": null
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans, Arial, sans-serif",
      "titleFont": "Manrope, Arial, sans-serif"
    }
  }
}