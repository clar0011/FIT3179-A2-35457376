{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mosaic plot of the composition of domestic overnight-trip expenditure by category and quarter. Each quarter column totals 100%; this is general domestic tourism, not adventure-specific spend.",
  "data": { "url": "data/expenditure-mosaic.json" },
  "width": "container",
  "height": 360,
  "mark": { "type": "rect", "stroke": "#ffffff", "strokeWidth": 0.7 },
  "encoding": {
    "x": {
      "field": "x0",
      "type": "quantitative",
      "scale": { "domain": [0, 1] },
      "axis": null
    },
    "x2": { "field": "x1" },
    "y": {
      "field": "y0",
      "type": "quantitative",
      "scale": { "domain": [0, 1], "reverse": true },
      "axis": null
    },
    "y2": { "field": "y1" },
    "color": {
      "field": "category",
      "type": "nominal",
      "scale": { "scheme": "tableau20" },
      "legend": { "title": "Expenditure category", "columns": 2 }
    },
    "tooltip": [
      { "field": "quarter", "title": "Quarter" },
      { "field": "category", "title": "Category" },
      { "field": "spend_million", "title": "Spend (A$M)", "format": "," },
      { "field": "share_pct", "title": "Quarter share (%)", "format": ".1f" }
    ]
  },
  "config": {
    "view": { "stroke": null },
    "axis": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "labelColor": "#52606d",
      "titleColor": "#243b53",
      "gridColor": "#e7edf1",
      "domainColor": "#c9d4dc",
      "tickColor": "#c9d4dc"
    },
    "legend": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "labelColor": "#52606d",
      "titleColor": "#243b53"
    }
  }
}
