{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Descriptive comparison of adult cycling participation and cycling-inclusive tourism trip counts by state. Not a causal relationship.",
  "data": { "url": "data/participation-tourism-scatter.json" },
  "width": "container",
  "height": 320,
  "mark": {
    "type": "point",
    "filled": true,
    "size": 160,
    "opacity": 0.82,
    "color": "#167d78"
  },
  "encoding": {
    "x": {
      "field": "cycling_participation_pct",
      "type": "quantitative",
      "axis": { "title": "Adult cycling participation (%)" }
    },
    "y": {
      "field": "cycling_tourism_trips",
      "type": "quantitative",
      "axis": { "title": "Cycling-inclusive trips (2024)", "format": "~s" }
    },
    "tooltip": [
      { "field": "state", "title": "State" },
      {
        "field": "cycling_participation_pct",
        "title": "Cycling participation (%)",
        "format": ".2f"
      },
      {
        "field": "cycling_tourism_trips",
        "title": "Cycling-inclusive trips",
        "format": ","
      }
    ]
  },
  "config": {
    "view": { "stroke": null },
    "axis": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "labelColor": "#52606d",
      "titleColor": "#243b53",
      "gridColor": "#e7edf1",
      "domainColor": "#c9d4dc",
      "tickColor": "#c9d4dc"
    },
    "legend": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "labelColor": "#52606d",
      "titleColor": "#243b53"
    }
  }
}
