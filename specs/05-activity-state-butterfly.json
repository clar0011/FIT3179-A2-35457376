{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Butterfly chart comparing adult cycling and bushwalking participation rates by Australian state and territory.",
  "data": { "url": "data/state-activity.json" },
  "padding": {
  "top": 50,
  "bottom": 35,
  "left": 10,
  "right": 10
},
  "transform": [
    {
      "filter": {
        "field": "activity",
        "oneOf": ["Cycling", "Bushwalking"]
      }
    },
    {
      "calculate": "datum.activity === 'Cycling' ? -datum.participation_rate_pct : datum.participation_rate_pct",
      "as": "signed_rate"
    }
  ],
  "width": "container",
  "height": 400,
  "layer": [
    {
      "mark": { "type": "bar", "cornerRadius": 3, "height": { "band": 0.68 } },
      "encoding": {
        "y": {
          "field": "state_code",
          "type": "ordinal",
          "sort": ["ACT", "NSW", "NT", "QLD", "SA", "TAS", "VIC", "WA"],
          "axis": { "title": null, "labelFontSize": 12, "labelPadding": 8 }
        },
        "x": {
          "field": "signed_rate",
          "type": "quantitative",
          "scale": { "domain": [-22, 22], "nice": false },
          "axis": {
            "title": "Adult participation rate (%)",
            "values": [-20, -15, -10, -5, 0, 5, 10, 15, 20],
            "labelExpr": "abs(datum.value) + '%'",
            "grid": true,
            "labelFontSize": 11
          }
        },
        "color": {
          "field": "activity",
          "type": "nominal",
          "scale": {
            "domain": ["Cycling", "Bushwalking"],
            "range": ["#D97732", "#287D78"]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "square",
            "labelFontSize": 12
          }
        },
        "tooltip": [
          { "field": "state", "title": "State" },
          { "field": "activity", "title": "Activity" },
          { "field": "participation_rate_pct", "title": "Participation rate", "format": ".2f", "formatType": "number" }
        ]
      }
    },
    {
      "data": { "values": [{ "zero": 0 }] },
      "mark": { "type": "rule", "color": "#829399", "strokeWidth": 1.2 },
      "encoding": {
        "x": { "field": "zero", "type": "quantitative", "scale": { "domain": [-22, 22] } }
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "font": "DM Sans, Arial, sans-serif",
    "axis": {
      "labelFont": "DM Sans, Arial, sans-serif",
      "titleFont": "DM Sans, Arial, sans-serif",
      "labelColor": "#52606d",
      "titleColor": "#243b53",
      "gridColor": "#e7edf1",
      "domainColor": "#c9d4dc",
      "tickColor": "#c9d4dc",
      "titleFontSize": 12,
      "labelFontSize": 12
    },
    "legend": {
      "labelFont": "DM Sans, Arial, sans-serif",
      "titleFont": "DM Sans, Arial, sans-serif",
      "labelColor": "#52606d",
      "titleColor": "#243b53"
    }
  }
}
